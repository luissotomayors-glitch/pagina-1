                <div class="rounded-2xl overflow-hidden glass-panel border border-white/10 group h-64">
                    <img src="https://images.unsplash.com/photo-1465847899084-d164df4dedc6?auto=format&fit=crop&w=600&q=80" alt="Soda Tour" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                </div>
            </div>
