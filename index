    <!-- COMUNIDAD FAN SECTION -->
    <section id="comunidad" class="py-24 bg-suedaDark/60 border-t border-white/5 relative">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="text-center mb-12">
                <span class="text-xs font-bold text-suedaCyan uppercase tracking-widest">Zona Stereo Fans</span>
                <h2 class="text-3xl sm:text-5xl font-display font-bold text-white uppercase mt-1">
                    Comunidad <span class="text-suedaNeon">Sueño Stereo</span>
                </h2>
                <p class="text-gray-400 text-sm mt-2">Comparte lo que significa este álbum legendario para ti.</p>
                <div class="w-20 h-1 bg-gradient-to-r from-suedaPurple via-suedaNeon to-suedaCyan mx-auto mt-4 rounded-full"></div>
            </div>

            <!-- Comment Input Box -->
            <div class="glass-panel p-6 rounded-2xl border border-suedaPurple/30 mb-8 shadow-xl">
                <div id="comment-guest-prompt" class="text-center py-4">
                    <i class="fa-solid fa-lock text-3xl text-suedaNeon/60 mb-2"></i>
                    <p class="text-sm text-gray-300">Debes iniciar sesión para publicar en la comunidad del álbum.</p>
                    <button onclick="openAuthModal('login')" class="mt-3 px-5 py-2 text-xs font-bold uppercase tracking-widest text-white bg-suedaPurple hover:bg-suedaPurple/80 rounded-full transition-all shadow-neon-purple">
                        Iniciar Sesión
                    </button>
                </div>

                <form id="comment-form" class="hidden space-y-4">
                    <div class="flex items-center space-x-3 mb-2">
                        <img id="comment-user-avatar" src="" alt="Avatar" class="w-8 h-8 rounded-full border border-suedaCyan">
                        <span id="comment-user-name" class="text-xs font-bold text-white"></span>
                        <span class="text-[10px] bg-suedaNeon/20 text-suedaNeon px-2 py-0.5 rounded-full uppercase">Stereo Fan</span>
