                    <textarea id="comment-text" rows="3" required placeholder="¿Qué sensaciones te produce escuchar Sueño Stereo? Escribe tu mensaje..." class="w-full bg-suedaDeep/80 border border-white/10 rounded-xl p-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-suedaNeon transition-all"></textarea>
                    <div class="flex justify-between items-center">
                        <span class="text-[11px] text-gray-500">Sé respetuoso con la comunidad.</span>
                        <button type="submit" class="px-6 py-2 bg-gradient-to-r from-suedaPurple to-suedaNeon hover:opacity-90 text-white font-bold text-xs uppercase tracking-widest rounded-full transition-all flex items-center space-x-2">
                            <i class="fa-solid fa-paper-plane text-xs"></i>
                            <span>Publicar</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Comments List -->
            <div id="comments-container" class="space-y-4">
                <div class="glass-panel p-5 rounded-xl border border-white/5 space-y-2">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center space-x-3">
                            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80" class="w-8 h-8 rounded-full border border-suedaPurple">
                            <div>
                                <h5 class="text-xs font-bold text-white">Marcos Cerati</h5>
                                <span class="text-[10px] text-gray-400">Hace 2 horas</span>
                            </div>
                        </div>
                        <span class="text-xs text-suedaCyan font-mono"><i class="fa-solid fa-heart text-suedaNeon mr-1"></i> Zoom</span>
                    </div>
                    <p class="text-xs text-gray-300 leading-relaxed">"Paseando por Roma" y "Disco Eterno" son cumbres absolutas del rock en nuestro idioma. La producción sonora de este disco sigue sonando del futuro 30 años después.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-suedaDark border-t border-suedaLila/10 py-12 text-center text-sm text-gray-500">
        <div class="max-w-7xl mx-auto px-4">
            <p class="font-serif tracking-widest uppercase text-xs mb-2 text-suedaLila">Sueño Stereo (1995) — Tributo Especial</p>
            <p class="text-xs text-gray-600">Soda Stereo • Gustavo Cerati • Zeta Bosio • Charly Alberti</p>
        </div>
    </footer>

    <!-- AUTHENTICATION MODAL (LOGIN / REGISTER) -->
    <div id="auth-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden transition-opacity duration-300">
        <div class="glass-panel w-full max-w-md rounded-3xl border border-suedaNeon/40 p-8 relative shadow-2xl bg-suedaDark/95">
            <button id="btn-close-modal" class="absolute top-5 right-5 text-gray-400 hover:text-white transition-colors text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="text-center mb-6">
                <div class="w-12 h-12 rounded-full bg-suedaNeon/10 border border-suedaNeon mx-auto flex items-center justify-center text-suedaNeon text-xl mb-3 shadow-neon-purple">
                    <i class="fa-solid fa-compact-disc animate-spin-slow"></i>
                </div>
                <h3 id="auth-modal-title" class="text-2xl font-display font-bold text-white uppercase tracking-wider">Iniciar Sesión</h3>
                <p id="auth-modal-subtitle" class="text-xs text-gray-400 mt-1">Ingresa a la zona de fans del portal Sueño Stereo</p>
            </div>

            <div id="auth-alert" class="hidden mb-4 p-3 rounded-xl text-xs text-center font-medium"></div>

            <form id="auth-form" class="space-y-4">
                <div id="field-name-container" class="hidden space-y-1">
                    <label class="text-[11px] font-semibold text-gray-300 uppercase tracking-wider">Nombre de Usuario</label>
                    <div class="relative">
                        <i class="fa-solid fa-user absolute left-3.5 top-3.5 text-gray-500 text-xs"></i>
                        <input type="text" id="auth-name" placeholder="Ej: GustavoFan95" class="w-full bg-suedaDeep/90 border border-white/10 rounded-xl pl-9 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-suedaNeon transition-all">
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-gray-300 uppercase tracking-wider">Correo Electrónico</label>
                    <div class="relative">
                        <i class="fa-solid fa-envelope absolute left-3.5 top-3.5 text-gray-500 text-xs"></i>
                        <input type="email" id="auth-email" required placeholder="tu@correo.com" class="w-full bg-suedaDeep/90 border border-white/10 rounded-xl pl-9 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-suedaNeon transition-all">
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-semibold text-gray-300 uppercase tracking-wider">Contraseña</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-gray-500 text-xs"></i>
                        <input type="password" id="auth-password" required placeholder="••••••••" class="w-full bg-suedaDeep/90 border border-white/10 rounded-xl pl-9 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-suedaNeon transition-all">
                    </div>
                </div>

                <div id="field-avatar-container" class="hidden space-y-1">
                    <label class="text-[11px] font-semibold text-gray-300 uppercase tracking-wider">Elige tu Avatar</label>
                    <div class="flex justify-between items-center pt-1" id="avatar-picker">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80" data-avatar="1" class="avatar-option w-10 h-10 rounded-full border-2 border-suedaNeon cursor-pointer object-cover">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80" data-avatar="2" class="avatar-option w-10 h-10 rounded-full border-2 border-transparent hover:border-suedaCyan cursor-pointer object-cover">
                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=150&q=80" data-avatar="3" class="avatar-option w-10 h-10 rounded-full border-2 border-transparent hover:border-suedaCyan cursor-pointer object-cover">
                        <img src="https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?auto=format&fit=crop&w=150&q=80" data-avatar="4" class="avatar-option w-10 h-10 rounded-full border-2 border-transparent hover:border-suedaCyan cursor-pointer object-cover">
                    </div>
                </div>

                <div id="remember-container" class="flex items-center justify-between text-xs text-gray-400 pt-1">
                    <label class="flex items-center space-x-2 cursor-pointer">
                        <input type="checkbox" id="remember-me" checked class="rounded bg-suedaDeep border-white/20 text-suedaNeon focus:ring-0">
                        <span>Recordar mi sesión</span>
                    </label>
                </div>

                <button type="submit" id="auth-submit-btn" class="w-full py-3 bg-gradient-to-r from-suedaPurple via-suedaNeon to-suedaCyan text-white font-bold text-xs uppercase tracking-widest rounded-xl shadow-neon-purple hover:opacity-90 transition-all hover:scale-[1.02] mt-4">
                    Iniciar Sesión
                </button>
            </form>

            <div class="text-center mt-6 pt-4 border-t border-white/10 text-xs text-gray-400">
                <span id="auth-toggle-text">¿No tienes cuenta de fan aún?</span>
                <button id="btn-toggle-auth" class="text-suedaNeon font-bold hover:underline ml-1">Regístrate gratis</button>
            </div>
        </div>
    </div>

    <!-- FAVORITES MODAL -->
    <div id="favs-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
        <div class="glass-panel w-full max-w-lg rounded-3xl border border-suedaCyan/40 p-6 relative shadow-2xl bg-suedaDark/95">
            <button onclick="closeFavoritesModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="flex items-center space-x-3 mb-4">
                <i class="fa-solid fa-heart text-suedaNeon text-2xl"></i>
                <div>
                    <h3 class="text-xl font-display font-bold text-white uppercase">Mis Canciones Favoritas</h3>
                    <p class="text-xs text-gray-400">Sueño Stereo (1995)</p>
                </div>
            </div>
            <div id="favs-list-container" class="space-y-2 max-h-60 overflow-y-auto pr-1">
            </div>
        </div>
    </div>

    <!-- INTERACTIVE JAVASCRIPT -->
    <script>
        // State
        let currentAuthMode = 'login';
        let currentUser = JSON.parse(localStorage.getItem('sueno_stereo_user')) || null;
        let userFavorites = JSON.parse(localStorage.getItem('sueno_stereo_favs')) || [];
        let selectedAvatarUrl = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80";

        // Navigation Elements
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        if (menuBtn) {
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
                menuIcon.className = mobileMenu.classList.contains('hidden') ? 'fa-solid fa-bars' : 'fa-solid fa-xmark';
            });
        }

        // Tracklist selection
        const trackCards = document.querySelectorAll('.track-card');
        const detailNum = document.getElementById('detail-num');
        const detailTitle = document.getElementById('detail-title');
        const detailDuration = document.getElementById('detail-duration');
        const detailDesc = document.getElementById('detail-desc');
        const detailLyric = document.getElementById('detail-lyric');

        trackCards.forEach(card => {
            card.addEventListener('click', () => {
                trackCards.forEach(c => {
                    c.classList.remove('border-suedaNeon/40');
                    c.classList.add('border-transparent');
                    const num = c.querySelector('.font-mono');
                    if (num) {
                        num.classList.remove('text-suedaNeon');
                        num.classList.add('text-gray-500');
                    }
                });

                card.classList.remove('border-transparent');
                card.classList.add('border-suedaNeon/40');
                const activeNum = card.querySelector('.font-mono');
                if (activeNum) {
                    activeNum.classList.remove('text-gray-500');
                    activeNum.classList.add('text-suedaNeon');
                }

                if (detailNum) detailNum.innerText = card.getAttribute('data-number');
                if (detailTitle) detailTitle.innerText = card.getAttribute('data-title');
                if (detailDuration) detailDuration.innerText = card.getAttribute('data-duration');
                if (detailDesc) detailDesc.innerText = card.getAttribute('data-desc');
                if (detailLyric) detailLyric.innerText = card.getAttribute('data-lyric');
            });
        });

        // Auth Elements
        const authModal = document.getElementById('auth-modal');
        const btnOpenLogin = document.getElementById('btn-open-login');
        const btnCloseModal = document.getElementById('btn-close-modal');
        const btnToggleAuth = document.getElementById('btn-toggle-auth');
        const authForm = document.getElementById('auth-form');
        const authModalTitle = document.getElementById('auth-modal-title');
        const authModalSubtitle = document.getElementById('auth-modal-subtitle');
        const authSubmitBtn = document.getElementById('auth-submit-btn');
        const authToggleText = document.getElementById('auth-toggle-text');
        const fieldNameContainer = document.getElementById('field-name-container');
        const fieldAvatarContainer = document.getElementById('field-avatar-container');
        const rememberContainer = document.getElementById('remember-container');
        const authAlert = document.getElementById('auth-alert');

        const userProfileMenu = document.getElementById('user-profile-menu');
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const userDisplayName = document.getElementById('user-display-name');
        const userAvatar = document.getElementById('user-avatar');
        const userDropdownEmail = document.getElementById('user-dropdown-email');
        const btnLogout = document.getElementById('btn-logout');

        const commentGuestPrompt = document.getElementById('comment-guest-prompt');
        const commentForm = document.getElementById('comment-form');
        const commentUserAvatar = document.getElementById('comment-user-avatar');
        const commentUserName = document.getElementById('comment-user-name');
        const commentText = document.getElementById('comment-text');
        const commentsContainer = document.getElementById('comments-container');
        const favCountSpan = document.getElementById('fav-count');

        // Functions
        function openAuthModal(mode = 'login') {
            currentAuthMode = mode;
            updateModalView();
            if (authModal) authModal.classList.remove('hidden');
        }

        function closeAuthModal() {
            if (authModal) authModal.classList.add('hidden');
            hideAlert();
        }

        if (btnOpenLogin) btnOpenLogin.addEventListener('click', () => openAuthModal('login'));
        if (btnCloseModal) btnCloseModal.addEventListener('click', closeAuthModal);

        if (btnToggleAuth) {
            btnToggleAuth.addEventListener('click', (e) => {
                e.preventDefault();
                currentAuthMode = currentAuthMode === 'login' ? 'register' : 'login';
                updateModalView();
            });
        }

        function updateModalView() {
            hideAlert();
            if (currentAuthMode === 'login') {
                if (authModalTitle) authModalTitle.innerText = "Iniciar Sesión";
                if (authModalSubtitle) authModalSubtitle.innerText = "Ingresa a la zona de fans del portal Sueño Stereo";
                if (authSubmitBtn) authSubmitBtn.innerText = "Iniciar Sesión";
                if (authToggleText) authToggleText.innerText = "¿No tienes cuenta de fan aún?";
                if (btnToggleAuth) btnToggleAuth.innerText = "Regístrate gratis";
                if (fieldNameContainer) fieldNameContainer.classList.add('hidden');
                if (fieldAvatarContainer) fieldAvatarContainer.classList.add('hidden');
                if (rememberContainer) rememberContainer.classList.remove('hidden');
            } else {
                if (authModalTitle) authModalTitle.innerText = "Crear Cuenta Fan";
                if (authModalSubtitle) authModalSubtitle.innerText = "Únete a la comunidad tributo a Soda Stereo";
                if (authSubmitBtn) authSubmitBtn.innerText = "Registrarme";
                if (authToggleText) authToggleText.innerText = "¿Ya tienes cuenta?";
                if (btnToggleAuth) btnToggleAuth.innerText = "Inicia sesión";
                if (fieldNameContainer) fieldNameContainer.classList.remove('hidden');
                if (fieldAvatarContainer) fieldAvatarContainer.classList.remove('hidden');
                if (rememberContainer) rememberContainer.classList.add('hidden');
            }
        }

        document.querySelectorAll('.avatar-option').forEach(img => {
            img.addEventListener('click', () => {
                document.querySelectorAll('.avatar-option').forEach(i => i.classList.replace('border-suedaNeon', 'border-transparent'));
                img.classList.replace('border-transparent', 'border-suedaNeon');
                selectedAvatarUrl = img.src;
            });
        });

        function showAlert(msg, isError = true) {
            if (!authAlert) return;
            authAlert.innerText = msg;
            authAlert.className = `mb-4 p-3 rounded-xl text-xs text-center font-medium ${isError ? 'bg-rose-500/20 text-rose-300 border border-rose-500/40' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'}`;
            authAlert.classList.remove('hidden');
        }

        function hideAlert() {
            if (authAlert) authAlert.classList.add('hidden');
        }

        if (authForm) {
            authForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const email = document.getElementById('auth-email').value;

                if (currentAuthMode === 'login') {
                    const name = email.split('@')[0];
                    currentUser = {
                        name: name.charAt(0).toUpperCase() + name.slice(1),
                        email: email,
                        avatar: selectedAvatarUrl
                    };
                    showAlert("¡Sesión iniciada con éxito!", false);
                } else {
                    const nameInput = document.getElementById('auth-name').value;
                    currentUser = {
                        name: nameInput || "Fan Stereo",
                        email: email,
                        avatar: selectedAvatarUrl
                    };
                    showAlert("¡Cuenta creada exitosamente!", false);
                }

                localStorage.setItem('sueno_stereo_user', JSON.stringify(currentUser));

                setTimeout(() => {
                    closeAuthModal();
                    updateUIAuthState();
                }, 600);
            });
        }

        if (userMenuBtn) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (userDropdown) userDropdown.classList.toggle('hidden');
            });
        }

        document.addEventListener('click', () => {
            if (userDropdown) userDropdown.classList.add('hidden');
        });

        if (btnLogout) {
            btnLogout.addEventListener('click', () => {
                currentUser = null;
                localStorage.removeItem('sueno_stereo_user');
                updateUIAuthState();
            });
        }

        function updateUIAuthState() {
            if (currentUser) {
                if (btnOpenLogin) btnOpenLogin.classList.add('hidden');
                if (userProfileMenu) userProfileMenu.classList.remove('hidden');
                if (userDisplayName) userDisplayName.innerText = currentUser.name;
                if (userDropdownEmail) userDropdownEmail.innerText = currentUser.email;
                if (userAvatar) userAvatar.src = currentUser.avatar;

                if (commentGuestPrompt) commentGuestPrompt.classList.add('hidden');
                if (commentForm) commentForm.classList.remove('hidden');
                if (commentUserAvatar) commentUserAvatar.src = currentUser.avatar;
                if (commentUserName) commentUserName.innerText = currentUser.name;
            } else {
                if (btnOpenLogin) btnOpenLogin.classList.remove('hidden');
                if (userProfileMenu) userProfileMenu.classList.add('hidden');

                if (commentGuestPrompt) commentGuestPrompt.classList.remove('hidden');
                if (commentForm) commentForm.classList.add('hidden');
            }
            if (favCountSpan) favCountSpan.innerText = userFavorites.length;
        }

        function toggleFavorite(songTitle) {
            if (!currentUser) {
                openAuthModal('login');
                return;
            }

            const index = userFavorites.indexOf(songTitle);
            if (index > -1) {
                userFavorites.splice(index, 1);
            } else {
                userFavorites.push(songTitle);
            }
            localStorage.setItem('sueno_stereo_favs', JSON.stringify(userFavorites));
            if (favCountSpan) favCountSpan.innerText = userFavorites.length;
            renderFavoritesButtons();
        }

        function renderFavoritesButtons() {
            document.querySelectorAll('.btn-fav-song').forEach(btn => {
                const song = btn.getAttribute('data-song');
                if (userFavorites.includes(song)) {
                    btn.classList.add('text-suedaNeon');
                    btn.classList.remove('text-gray-500');
                } else {
                    btn.classList.remove('text-suedaNeon');
                    btn.classList.add('text-gray-500');
                }
            });
        }

        function showFavoritesModal() {
            const container = document.getElementById('favs-list-container');
            if (!container) return;
            container.innerHTML = '';
            if (userFavorites.length === 0) {
                container.innerHTML = `<p class="text-xs text-gray-400 py-4 text-center">Aún no has agregado canciones a tus favoritas. Presiona el corazón en la lista de canciones.</p>`;
            } else {
                userFavorites.forEach(song => {
                    container.innerHTML += `
                        <div class="glass-panel p-3 rounded-xl flex items-center justify-between border border-white/5">
                            <div class="flex items-center space-x-3">
                                <i class="fa-solid fa-compact-disc text-suedaCyan"></i>
                                <span class="text-xs font-bold text-white">${song}</span>
                            </div>
                            <button onclick="toggleFavorite('${song}'); showFavoritesModal();" class="text-xs text-rose-400 hover:text-rose-300">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    `;
                });
            }
            const modal = document.getElementById('favs-modal');
            if (modal) modal.classList.remove('hidden');
        }

        function closeFavoritesModal() {
            const modal = document.getElementById('favs-modal');
            if (modal) modal.classList.add('hidden');
        }

        if (commentForm) {
            commentForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const text = commentText.value.trim();
                if (!text || !currentUser) return;

                const newComment = document.createElement('div');
                newComment.className = 'glass-panel p-5 rounded-xl border border-suedaNeon/20 space-y-2';
                newComment.innerHTML = `
                    <div class="flex justify-between items-center">
                        <div class="flex items-center space-x-3">
                            <img src="${currentUser.avatar}" class="w-8 h-8 rounded-full border border-suedaNeon object-cover">
                            <div>
                                <h5 class="text-xs font-bold text-white">${currentUser.name}</h5>
                                <span class="text-[10px] text-suedaNeon">Recién publicado</span>
                            </div>
                        </div>
                        <span class="text-[10px] bg-suedaPurple/30 text-suedaCyan px-2 py-0.5 rounded-full uppercase">Fan Auténtico</span>
                    </div>
                    <p class="text-xs text-gray-200 leading-relaxed">${text}</p>
                `;
                if (commentsContainer) commentsContainer.prepend(newComment);
                commentText.value = '';
            });
        }

        // Initialize on DOM Ready
        document.addEventListener('DOMContentLoaded', () => {
            updateUIAuthState();
            renderFavoritesButtons();
        });
    </script>
</body>
</html>
